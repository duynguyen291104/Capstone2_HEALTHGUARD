APP_NAME=HealthGuard API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://eldercare_app:CHANGE_ME@localhost:5432/eldercare_dev
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
COOKIE_NAME=healthguard_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
WORKER_POLL_SECONDS=30
OCCURRENCE_HORIZON_HOURS=36
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# OCR local: chay setup-ocr.cmd mot lan. Tu dong tim Tesseract tren Windows/PATH.
# Neu cai o vi tri khac, bo dau # va sua hai duong dan ben duoi.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSERACT_DATA_DIR=C:/Program Files/Tesseract-OCR/tessdata
OCR_TIMEOUT_SECONDS=30
OCR_REQUESTS_PER_HOUR=20
