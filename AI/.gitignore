# Keep directory contracts in git
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/models/.gitkeep
!artifacts/.gitkeep
!runtime/.gitkeep

# Runtime models required by a fresh clone
!artifacts/urfd_preview_gru/
